    {
        "id": "bd371dfe43664a1b",
        "type": "function",
        "z": "f08d5c60e8337015",
        "name": "function 1",
        "func": "let d = msg.payload;\n\n// Recuperamos la memoria del nodo para evitar repintar datos repetidos\nlet prev = context.get(\"estado_previo\") || {};\nlet nuevos = {};\n\nfunction rbe(clave, nuevoValor) {\n    if (prev[clave] !== nuevoValor) {\n        nuevos[clave] = nuevoValor;\n        return { payload: nuevoValor }; \n    }\n    return null; \n}\n\n// 1. TEXTOS (Salidas 1 a 16)\nlet outX = rbe(\"x\", d.x.toFixed(2));\nlet outY = rbe(\"y\", d.y.toFixed(2));\nlet outZ = rbe(\"z\", d.z.toFixed(2));\n\nlet outJ1 = rbe(\"j1\", d.j1.toFixed(2));\nlet outJ2 = rbe(\"j2\", d.j2.toFixed(2));\nlet outJ3 = rbe(\"j3\", d.j3.toFixed(2));\nlet outJ4 = rbe(\"j4\", d.j4.toFixed(2));\nlet outJ5 = rbe(\"j5\", d.j5.toFixed(2));\nlet outJ6 = rbe(\"j6\", d.j6.toFixed(2));\n\nlet outModo = rbe(\"modo\", d.modo_operacion);\nlet outDeadman = rbe(\"dm\", d.seguridad.deadman ? \"ACTIVO\" : \"INACTIVO\");\nlet outEstop = rbe(\"estop\", d.seguridad.e_stop ? \"EMERGENCIA\" : \"OK\");\nlet outVacio = rbe(\"vacio\", d.vacio_activo ? \"SUCCIONANDO\" : \"APAGADO\");\nlet outPayload = rbe(\"payload\", d.payload_kg.toFixed(1) + \" kg\");\nlet outCiclos = rbe(\"ciclos\", d.ciclos_total);\nlet outTiempo = rbe(\"tiempo\", d.tiempo_ciclo_s + \" s\");\n\n// 2. TEMPERATURAS (Salidas 17 a 22) - Parseadas a flotante para el Gauge\nlet t1 = rbe(\"t1\", parseFloat(d.temperaturas_c[0].toFixed(1)));\nlet t2 = rbe(\"t2\", parseFloat(d.temperaturas_c[1].toFixed(1)));\nlet t3 = rbe(\"t3\", parseFloat(d.temperaturas_c[2].toFixed(1)));\nlet t4 = rbe(\"t4\", parseFloat(d.temperaturas_c[3].toFixed(1)));\nlet t5 = rbe(\"t5\", parseFloat(d.temperaturas_c[4].toFixed(1)));\nlet t6 = rbe(\"t6\", parseFloat(d.temperaturas_c[5].toFixed(1)));\n\n// 3. CORRIENTES (Salidas 23 a 28) - Parseadas a flotante\nlet c1 = rbe(\"c1\", parseFloat(d.corrientes_a[0].toFixed(2)));\nlet c2 = rbe(\"c2\", parseFloat(d.corrientes_a[1].toFixed(2)));\nlet c3 = rbe(\"c3\", parseFloat(d.corrientes_a[2].toFixed(2)));\nlet c4 = rbe(\"c4\", parseFloat(d.corrientes_a[3].toFixed(2)));\nlet c5 = rbe(\"c5\", parseFloat(d.corrientes_a[4].toFixed(2)));\nlet c6 = rbe(\"c6\", parseFloat(d.corrientes_a[5].toFixed(2)));\n\n// Guardamos estado para el siguiente ciclo\ncontext.set(\"estado_previo\", Object.assign(prev, nuevos));\n\n// DESPACHO ESTRUCTURADO (El orden de este arreglo dicta el orden de los pines grises)\nreturn [\n    outX, outY, outZ, \n    outJ1, outJ2, outJ3, outJ4, outJ5, outJ6, \n    outModo, outDeadman, outEstop, \n    outVacio, outPayload, outCiclos, outTiempo, \n    t1, t2, t3, t4, t5, t6, \n    c1, c2, c3, c4, c5, c6\n];",
        "outputs": 28,
        "timeout": 0,
        "noerr": 0,
