    {
        "id": "bd371dfe43664a1b",
        "type": "function",
        "z": "f08d5c60e8337015",
        "name": "function 1",
        "func": "let d = msg.payload;\n\n// Recuperamos la memoria del nodo (el estado del milisegundo anterior)\nlet prev = context.get(\"estado_previo\") || {};\nlet nuevos = {};\n\n// Función colador: Solo deja pasar el dato si es diferente al anterior\nfunction rbe(clave, nuevoValor) {\n    if (prev[clave] !== nuevoValor) {\n        nuevos[clave] = nuevoValor; // Lo guardamos para el futuro\n        return { payload: nuevoValor }; // Disparamos la actualización visual\n    }\n    return null; // Si es igual, matamos el mensaje para no saturar la pantalla\n}\n\n// 1. Textos discretos (Solo se actualizan si el robot se mueve)\nlet outX = rbe(\"x\", d.x.toFixed(2));\nlet outY = rbe(\"y\", d.y.toFixed(2));\nlet outZ = rbe(\"z\", d.z.toFixed(2));\n\nlet outJ1 = rbe(\"j1\", d.j1.toFixed(2));\nlet outJ2 = rbe(\"j2\", d.j2.toFixed(2));\nlet outJ3 = rbe(\"j3\", d.j3.toFixed(2));\nlet outJ4 = rbe(\"j4\", d.j4.toFixed(2));\nlet outJ5 = rbe(\"j5\", d.j5.toFixed(2));\nlet outJ6 = rbe(\"j6\", d.j6.toFixed(2));\n\nlet outModo = rbe(\"modo\", d.modo_operacion);\nlet outDeadman = rbe(\"dm\", d.seguridad.deadman ? \"ACTIVO\" : \"INACTIVO\");\nlet outEstop = rbe(\"estop\", d.seguridad.e_stop ? \"EMERGENCIA\" : \"OK\");\n\nlet outVacio = rbe(\"vacio\", d.vacio_activo ? \"SUCCIONANDO\" : \"APAGADO\");\nlet outPayload = rbe(\"payload\", d.payload_kg.toFixed(1) + \" kg\");\nlet outCiclos = rbe(\"ciclos\", d.ciclos_total);\nlet outTiempo = rbe(\"tiempo\", d.tiempo_ciclo_s + \" s\");\n\n// 2. Gráficas (Estas SÍ se envían siempre para que el eje X siga avanzando)\nlet temps = [0,1,2,3,4,5].map(i => ({ topic: \"J\" + (i+1), payload: d.temperaturas_c[i] }));\nlet currents = [0,1,2,3,4,5].map(i => ({ topic: \"J\" + (i+1), payload: d.corrientes_a[i] }));\n\n// Guardamos los valores que sí cambiaron en la memoria del nodo\ncontext.set(\"estado_previo\", Object.assign(prev, nuevos));\n\n// 3. Despachamos todo\nnode.send([outX, outY, outZ, outJ1, outJ2, outJ3, outJ4, outJ5, outJ6, outModo, outDeadman, outEstop, outVacio, outPayload, outCiclos, outTiempo, null, null]);\n\n// Enviamos los puntos de las gráficas individualmente\ntemps.forEach(item => node.send([null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, item, null]));\ncurrents.forEach(item => node.send([null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, item]));\n\nreturn null;",
        "outputs": 18,
